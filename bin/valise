#!/bin/sh

# Copyright (c) 2026 Joseph Cumines
# SPDX-License-Identifier: MIT
# valise - user-facing CLI for the valise-sh shell profile engine.
# Pure POSIX /bin/sh. Zero non-POSIX runtime dependencies.

set -eu

VALISE_VERSION="0.2.0"

# The path this CLI was invoked by, made absolute before -C can change the
# working directory. The Fish hook calls the CLI back through it, so a package
# symlink stays the entry point across upgrades.
case "$0" in
  /*) _valise_cli_path=$0 ;;
  *) _valise_cli_path="$(pwd -P)/$0" ;;
esac

# Locate the engine from this script's physical path, so package installs
# that expose bin/valise through a symlink (bun, npm) still find ../lib. This
# runs before any helper is loaded, so it uses only parameter expansion,
# readlink, cd and pwd.
_valise_self=$0
while [ -L "$_valise_self" ]; do
  _valise_link=$(readlink "$_valise_self") || {
    printf 'valise: error: cannot resolve %s\n' "$_valise_self" >&2
    exit 1
  }
  case "$_valise_link" in
    /*) _valise_self=$_valise_link ;;
    *)
      case "$_valise_self" in
        */*) _valise_self=${_valise_self%/*}/$_valise_link ;;
        *) _valise_self=$_valise_link ;;
      esac
      ;;
  esac
done
case "$_valise_self" in
  */*) _valise_self_dir=${_valise_self%/*} ;;
  *) _valise_self_dir=. ;;
esac
_valise_engine_bin=$(cd "${_valise_self_dir:-/}" && pwd -P) || {
  printf 'valise: error: cannot locate the valise engine from %s\n' "$0" >&2
  exit 1
}
VALISE_CLI_DIR="${_valise_engine_bin%/}/../lib/cli"
for _valise_part in usage common store fish-hook integration commands lifecycle devtools project; do
  if [ ! -f "$VALISE_CLI_DIR/$_valise_part.sh" ]; then
    printf 'valise: error: incomplete installation: missing lib/cli/%s.sh\n' "$_valise_part" >&2
    exit 1
  fi
  . "$VALISE_CLI_DIR/$_valise_part.sh"
done
unset _valise_part _valise_self _valise_self_dir _valise_link

# --- Main dispatch ---

# -C <dir> runs the command as if valise had been started in dir.
while [ "$#" -gt 0 ]; do
  case "$1" in
    -C)
      [ "$#" -ge 2 ] && [ -n "$2" ] || die "-C needs a directory"
      cd "$2" 2>/dev/null || die "cannot change to directory: $2"
      shift 2
      ;;
    -C*)
      cd "${1#-C}" 2>/dev/null || die "cannot change to directory: ${1#-C}"
      shift
      ;;
    *) break ;;
  esac
done

_cmd="${1:-}"
# POSIX shells may treat a zero-argument shift as a fatal error under -e,
# even when guarded by an OR-list. Only shift when there is an argument.
if [ "$#" -gt 0 ]; then
  shift
fi

case "$_cmd" in
  init)    cmd_init "$@" ;;
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  _verify-release-root) cmd_verify_release_root "$@" ;;
  doctor)  cmd_doctor "$@" ;;
  release) cmd_release "$@" ;;
  make-manifest) cmd_make_manifest "$@" ;;
  registry) cmd_registry "$@" ;;
  new) cmd_new "$@" ;;
  module) cmd_module "$@" ;;
  build) cmd_build "$@" ;;
  apply) cmd_apply "$@" ;;
  status) cmd_status "$@" ;;
  lint) cmd_lint "$@" ;;
  test) cmd_test "$@" ;;
  run) cmd_run "$@" ;;
  env) cmd_env "$@" ;;
  compile) cmd_compile "$@" ;;
  explain-variant) cmd_explain_variant "$@" ;;
  explain-bundles) cmd_explain_bundles "$@" ;;
  layer-lint)  cmd_layer_lint "$@" ;;
  version|--version|-v) cmd_version ;;
  help|--help|-h|'') usage ;;
  *)       die "unknown command: $_cmd (run 'valise help')" ;;
esac
