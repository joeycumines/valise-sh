    "      set -l _global_values_var \"\$_restore_prefix\"_global_values" \
    "      set -l _universal_present_var \"\$_restore_prefix\"_universal_present" \
    "      set -l _universal_exported_var \"\$_restore_prefix\"_universal_exported" \
