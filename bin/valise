    "                set _metadata_protected_changed 1" \
    "                break" \
    "              end" \
    "              set _metadata_value_index (builtin math \$_metadata_value_index + 1)" \
    "            end" \
    "          end" \
    "        end" \
    "      end" \
    "    end" \
    "    set -l _metadata_after (builtin functions --all --names)" \
