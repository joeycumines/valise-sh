#!/bin/sh

# Copyright (c) 2026 Joseph Cumines
# SPDX-License-Identifier: MIT
# valise - user-facing CLI for the valise-sh shell profile engine.
# Pure POSIX /bin/sh. Zero non-POSIX runtime dependencies.

set -eu

VALISE_VERSION="0.1.0"

# XDG defaults per install-contracts.md
VALISE_XDG_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/valise"
VALISE_XDG_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/valise"
VALISE_XDG_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/valise"
VALISE_RELEASES_DIR="$VALISE_XDG_DATA/releases"
VALISE_ACTIVE_LINK="$VALISE_XDG_CONFIG/active"
VALISE_LOCK_DIR="$VALISE_XDG_STATE/lock"

usage() {
  printf '%s\n' \
    "Usage: valise <command> [options]" \
    "" \
    "Commands:" \
    "  init [bash|zsh|ksh|sh|profile|fish] [--compiled]  Output shell integration snippet" \
    "  install [--no-shell-integration]  Install or update the active release" \
    "  verify-active [--print-root] Verify the sealed active release" \
    "  doctor                     Run environment diagnostics" \
    "  variant [list|use <sha>]   List installed releases / switch active release" \
    "  make-manifest <tree> [--output <file>]  Write a release manifest for a tree" \
    "  registry [--check] [path]  Generate or verify module-registry.tsv from metadata (consuming project)" \
    "  compile [--bundle=<name>] [--variant=<name>] <output-dir>  (consuming project)" \
    "  assemble [--bundle=<name>] [--variant=<name>] <out-dir>  Compile and build a release tree (consuming project)" \
    "  explain-variant [name]     Show variant details and per-shell impact (consuming project)" \
    "  explain-bundles            Explain installed bundle roots and closure (consuming project)" \
    "  layer-lint <name>          Validate a contribution layer structure (consuming project)" \
    "  version                    Print version" \
    "" \
    "Environment:" \
    "  XDG_DATA_HOME    Release storage root (default: ~/.local/share)" \
    "  XDG_CONFIG_HOME  Active pointer symlink (default: ~/.config)" \
    "  XDG_STATE_HOME   Lock and journal state (default: ~/.local/state)"
}

die() {
  printf 'valise: error: %s\n' "$*" >&2
  exit 1
}

info() {
  printf 'valise: %s\n' "$*"
}

# Lexically normalize an absolute path: collapse repeated slashes, drop "."
# segments, and resolve ".." against the preceding component. Relative paths
# are resolved against the physical working directory first.
path_normalize() {
  _path_norm_value=$1
  case "$_path_norm_value" in
    /*) ;;
    *) _path_norm_value=$(pwd -P)/$_path_norm_value ;;
  esac
  _path_norm_out=
  if [ "${IFS+x}" = x ]; then
    _path_norm_ifs_was_set=1
    _path_norm_old_ifs=${IFS-}
  else
    _path_norm_ifs_was_set=0
    _path_norm_old_ifs=
  fi
  case $- in
    *f*) _path_norm_glob_was_set=1 ;;
    *) _path_norm_glob_was_set=0 ;;
  esac
  set -f
  IFS=/
  for _path_norm_part in $_path_norm_value; do
    case "$_path_norm_part" in
      ''|.) continue ;;
      ..)
        case "$_path_norm_out" in
          '') ;;
          */*) _path_norm_out=${_path_norm_out%/*} ;;
          *) _path_norm_out= ;;
        esac
        continue
        ;;
    esac
    _path_norm_out=${_path_norm_out:+$_path_norm_out/}$_path_norm_part
  done
  if [ "$_path_norm_ifs_was_set" -eq 1 ]; then
    IFS=$_path_norm_old_ifs
  else
    unset IFS
  fi
  if [ "$_path_norm_glob_was_set" -eq 0 ]; then
    set +f
  fi
  printf '/%s\n' "$_path_norm_out"
}

# POSIX path parent extraction avoids ambient dirname resolution in manifest
# discovery and every subsequent source/destination validation path.
path_parent() {
  _path_parent_value=$1
  # Strip trailing slashes so "out/" and "out" share one parent (".").
  # Without this, path_parent("out/") is "out" itself: parent-mkdir creates
  # the destination, the emptiness check treats it as pre-created-empty, and
  # staging lands inside the destination (publish then fails ENOTEMPTY).
  while [ "$_path_parent_value" != "/" ] &&
    [ "${_path_parent_value%/}" != "$_path_parent_value" ]; do
    _path_parent_value=${_path_parent_value%/}
  done
  case "$_path_parent_value" in
    */*)
      _path_parent_value=${_path_parent_value%/*}
      [ -n "$_path_parent_value" ] || _path_parent_value=/
      ;;
    *) _path_parent_value=. ;;
  esac
  printf '%s\n' "$_path_parent_value"
}

# Directory of this script with symlinks resolved, so package installs that
# expose bin/valise through a symlink (bun, npm) still find ../lib.
valise_script_dir() {
  _vsd_path=$0
  while [ -L "$_vsd_path" ]; do
    _vsd_target=$(readlink "$_vsd_path") || return 1
    case "$_vsd_target" in
      /*) _vsd_path=$_vsd_target ;;
      *) _vsd_path=$(path_parent "$_vsd_path")/$_vsd_target ;;
    esac
  done
  (cd "$(path_parent "$_vsd_path")" && pwd -P)
}

# Emit a single-quoted literal for generated POSIX shell code. The generated
# snippets must not interpolate user-controlled XDG paths into double quotes:
# `$()` and backticks would still execute there. POSIX single quotes preserve
# every character except apostrophe, which is represented by the standard
# '\'' sequence.
shell_quote() {
  _shell_quote_value=$1
  printf "'"
  while [ -n "$_shell_quote_value" ]; do
    _shell_quote_char=${_shell_quote_value%"${_shell_quote_value#?}"}
    _shell_quote_value=${_shell_quote_value#?}
    case "$_shell_quote_char" in
      "'") printf "%s" "'\\''" ;;
      *) printf '%s' "$_shell_quote_char" ;;
    esac
  done
  printf "'"
}

# Fish single-quoted literals use a backslash-escaped apostrophe. Encode each
# source backslash as two backslashes so a backslash immediately before an
# apostrophe cannot change the quote grammar. Dollar signs, semicolons, and
# command-substitution markers remain literal, so arbitrary XDG paths cannot
# inject Fish commands.
fish_quote() {
  _fish_quote_value=$1
  printf "'"
  while [ -n "$_fish_quote_value" ]; do
    _fish_quote_char=${_fish_quote_value%"${_fish_quote_value#?}"}
    _fish_quote_value=${_fish_quote_value#?}
    case "$_fish_quote_char" in
      \\) printf '%s' '\\' ;;
      "'") printf '%s' "\\'" ;;
      *) printf '%s' "$_fish_quote_char" ;;
    esac
  done
  printf "'"
}

trusted_uname() {
  if [ -x /usr/bin/uname ]; then
    /usr/bin/uname "$@"
  elif [ -x /bin/uname ]; then
    /bin/uname "$@"
  else
    return 1
  fi
}

# Resolve only platform-owned utility paths for integrity operations. These
# checks must not be redirected by a caller-controlled PATH.
trusted_utility_path() {
  case "$1" in
    awk) _trusted_candidates='/usr/bin/awk /bin/awk' ;;
    cat) _trusted_candidates='/bin/cat /usr/bin/cat' ;;
    cp) _trusted_candidates='/bin/cp /usr/bin/cp' ;;
    chmod) _trusted_candidates='/bin/chmod /usr/bin/chmod' ;;
    cmp) _trusted_candidates='/usr/bin/cmp /bin/cmp' ;;
    ln) _trusted_candidates='/bin/ln /usr/bin/ln' ;;
    mkdir) _trusted_candidates='/bin/mkdir /usr/bin/mkdir' ;;
    kill) _trusted_candidates='/bin/kill /usr/bin/kill' ;;
    mktemp) _trusted_candidates='/usr/bin/mktemp /bin/mktemp /opt/homebrew/bin/mktemp /usr/local/bin/mktemp' ;;
    readlink) _trusted_candidates='/usr/bin/readlink /bin/readlink' ;;
    rmdir) _trusted_candidates='/bin/rmdir /usr/bin/rmdir' ;;
    find) _trusted_candidates='/usr/bin/find /bin/find' ;;
    fish) _trusted_candidates='/opt/homebrew/bin/fish /usr/local/bin/fish /usr/bin/fish /bin/fish' ;;
    mv) _trusted_candidates='/bin/mv /usr/bin/mv' ;;
    rm) _trusted_candidates='/bin/rm /usr/bin/rm' ;;
    stat) _trusted_candidates='/usr/bin/stat /bin/stat' ;;
    tr) _trusted_candidates='/usr/bin/tr /bin/tr' ;;
    wc) _trusted_candidates='/usr/bin/wc /bin/wc' ;;
    sha256sum) _trusted_candidates='/usr/bin/sha256sum /bin/sha256sum /sbin/sha256sum /opt/homebrew/bin/sha256sum /usr/local/bin/sha256sum' ;;
    sha256) _trusted_candidates='/usr/bin/sha256 /bin/sha256 /sbin/sha256 /opt/homebrew/bin/sha256 /usr/local/bin/sha256' ;;
    shasum) _trusted_candidates='/usr/bin/shasum /bin/shasum /opt/homebrew/bin/shasum /usr/local/bin/shasum' ;;
    sort) _trusted_candidates='/usr/bin/sort /bin/sort' ;;
    *) return 1 ;;
  esac
  for _trusted_candidate in $_trusted_candidates; do
    if [ -x "$_trusted_candidate" ]; then
      printf '%s\n' "$_trusted_candidate"
      return 0
    fi
  done
  return 1
}

readlink_target() {
  _readlink_path=$(trusted_utility_path readlink) || return 1
  "$_readlink_path" "$1"
}

# Return a file's three-digit permission mode in the manifest's octal form.
# BSD stat and GNU stat use different option spellings, so probe both.
file_mode() {
  _stat_path=$(trusted_utility_path stat) || return 1
  # BSD stat accepts -f; GNU stat accepts -c. GNU stat may nevertheless
  # accept -f as a filesystem-stat format and exit successfully, so select a
  # result by validating the output rather than relying on exit status alone.
  _mode_value=$("$_stat_path" -f '%Lp' "$1" 2>/dev/null || :)
  case "$_mode_value" in
    [0-7][0-7][0-7]) printf '0%s\n' "$_mode_value"; return 0 ;;
  esac
  _mode_value=$("$_stat_path" -c '%a' "$1" 2>/dev/null || :) || return 1
  case "$_mode_value" in
    [0-7][0-7][0-7]) printf '0%s\n' "$_mode_value" ;;
    *) return 1 ;;
  esac
}

# Return a regular file's exact byte count without locale-dependent padding.
file_bytes() {
  _wc_path=$(trusted_utility_path wc) || return 1
  _tr_path=$(trusted_utility_path tr) || return 1
  "$_wc_path" -c < "$1" | "$_tr_path" -d '[:space:]'
}

file_sha256() {
  _sha_path=$(trusted_utility_path sha256sum 2>/dev/null || :)
  if [ -n "$_sha_path" ]; then
    _sha_output=$("$_sha_path" "$1") || return 1
  else
    _sha_path=$(trusted_utility_path shasum 2>/dev/null || :)
    if [ -n "$_sha_path" ]; then
      _sha_output=$("$_sha_path" -a 256 "$1") || return 1
    else
      _sha_path=$(trusted_utility_path sha256 2>/dev/null || :)
      [ -n "$_sha_path" ] || return 1
      _sha_output=$("$_sha_path" "$1") || return 1
    fi
  fi
  # Supported utilities: sha256sum/shasum print "digest  filename";
  # BSD sha256 prints "SHA256 (filename) = digest" or just the digest.
  # The BSD format strip must be gated behind the SHA256 ( prefix: a
  # blanket *=* match corrupts sha256sum/shasum output whenever the
  # absolute file path contains "= " (equals followed by space).
  case "$_sha_output" in
    "SHA256 ("*) _sha_output=${_sha_output##* = } ;;
  esac
  _sha_output=${_sha_output%% *}
  _sha_output=${_sha_output%%$(printf '\t')*}
  printf '%s\n' "$_sha_output"
}

lower_hex() {
  _tr_path=$(trusted_utility_path tr) || return 1
  "$_tr_path" 'A-F' 'a-f'
}

# Acquire atomic lock via mkdir (POSIX atomic operation). Every utility that
# participates in lock integrity is resolved by absolute path so PATH cannot
# forge ownership or suppress stale-lock cleanup.
_lock_owned=0
_active_tmp=""
_active_backup=""
_publish_tmp=""
_manifest_rows=""
_manifest_parse=""
_stage=""
_hook_tmp=""
_mm_tmp=""
_posix_tmp=""
_mv_path=""
_cleanup_failed=0
acquire_lock() {
  _lock_cat_path=$(trusted_utility_path cat) || die "no trusted cat utility available"
  _lock_mkdir_path=$(trusted_utility_path mkdir) || die "no trusted mkdir utility available"
  _lock_rm_path=$(trusted_utility_path rm) || die "no trusted rm utility available"
  _lock_kill_path=$(trusted_utility_path kill) || die "no trusted kill utility available"

  # Reentrant ownership is valid only for a real lock directory and a real,
  # non-symlink pid file containing this process's exact PID.
  if [ "$_lock_owned" -eq 1 ] && [ -d "$VALISE_LOCK_DIR" ] && [ ! -L "$VALISE_LOCK_DIR" ] &&
     [ -f "$VALISE_LOCK_DIR/pid" ] && [ ! -L "$VALISE_LOCK_DIR/pid" ]; then
    _existing_pid=$("$_lock_cat_path" "$VALISE_LOCK_DIR/pid" 2>/dev/null || :)
    case "$_existing_pid" in
      ''|*[!0-9]*) : ;;
      "$$") _lock_owned=1; return 0 ;;
    esac
  fi

  _lock_parent=${VALISE_LOCK_DIR%/*}
  [ -n "$_lock_parent" ] || _lock_parent=/
  if [ ! -d "$_lock_parent" ]; then
    "$_lock_mkdir_path" -p "$_lock_parent" 2>/dev/null || die "cannot create lock parent: $_lock_parent"
  fi
  if ! "$_lock_mkdir_path" -m 700 "$VALISE_LOCK_DIR" 2>/dev/null; then
    # Check for stale lock using only the trusted utility paths. An invalid or
    # unreadable lock is fail-closed rather than treated as stale.
    if [ -d "$VALISE_LOCK_DIR" ] && [ ! -L "$VALISE_LOCK_DIR" ] &&
       [ -f "$VALISE_LOCK_DIR/pid" ] && [ ! -L "$VALISE_LOCK_DIR/pid" ]; then
      _lock_pid=$("$_lock_cat_path" "$VALISE_LOCK_DIR/pid" 2>/dev/null || :)
      case "$_lock_pid" in
        ''|*[!0-9]*) die "another valise process is running (unreadable lock)" ;;
      esac
      if ! "$_lock_kill_path" -0 "$_lock_pid" 2>/dev/null; then
        info "removing stale lock (pid $_lock_pid)"
        "$_lock_rm_path" -rf "$VALISE_LOCK_DIR" 2>/dev/null || die "failed to remove stale lock"
        if [ -e "$VALISE_LOCK_DIR" ] || [ -L "$VALISE_LOCK_DIR" ]; then
          die "failed to remove stale lock"
        fi
        "$_lock_mkdir_path" -m 700 "$VALISE_LOCK_DIR" 2>/dev/null || die "failed to acquire lock after stale cleanup"
      else
        die "another valise process is running (pid $_lock_pid)"
      fi
    else
      die "failed to acquire lock: $VALISE_LOCK_DIR"
    fi
  fi
  [ -d "$VALISE_LOCK_DIR" ] && [ ! -L "$VALISE_LOCK_DIR" ] || die "lock directory is not safe"
  printf '%s\n' "$$" > "$VALISE_LOCK_DIR/pid" || die "failed to write lock ownership"
  [ -f "$VALISE_LOCK_DIR/pid" ] && [ ! -L "$VALISE_LOCK_DIR/pid" ] || die "lock ownership file is not safe"
  _lock_pid=$("$_lock_cat_path" "$VALISE_LOCK_DIR/pid" 2>/dev/null || :)
  [ "$_lock_pid" = "$$" ] || die "failed to verify lock ownership"
  _lock_owned=1
}

remove_tree() {
  _remove_tree_path=$1
  _remove_chmod_path=$(trusted_utility_path chmod) || return 1
  _remove_rm_path=$(trusted_utility_path rm) || return 1
  if [ -d "$_remove_tree_path" ] && [ ! -L "$_remove_tree_path" ]; then
    "$_remove_chmod_path" -R u+w "$_remove_tree_path" 2>/dev/null || return 1
  fi
  "$_remove_rm_path" -rf "$_remove_tree_path" 2>/dev/null || return 1
  [ ! -e "$_remove_tree_path" ] && [ ! -L "$_remove_tree_path" ]
}

seal_tree() {
  _seal_tree_root=$1
  _find_path=$(trusted_utility_path find) || return 1
  _seal_chmod_path=$(trusted_utility_path chmod) || return 1
  "$_find_path" "$_seal_tree_root" -type d -exec "$_seal_chmod_path" 0555 {} + 2>/dev/null || return 1
  _seal_tree_dirs=$("$_find_path" "$_seal_tree_root" -type d -print) || return 1
  while IFS= read -r _seal_tree_dir; do
    [ -n "$_seal_tree_dir" ] || continue
    [ "$(file_mode "$_seal_tree_dir")" = "0555" ] || return 1
  done <<EOF
$_seal_tree_dirs
EOF
  return 0
}

release_lock() {
  _release_rm_path=$(trusted_utility_path rm 2>/dev/null || :)
  _release_rmdir_path=$(trusted_utility_path rmdir 2>/dev/null || :)
  if [ -n "$_active_tmp" ]; then
    [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_active_tmp" 2>/dev/null || :
    if [ -e "$_active_tmp" ] || [ -L "$_active_tmp" ]; then _cleanup_failed=1; fi
    _active_tmp=""
  fi
  if [ -n "$_active_backup" ]; then
    if [ -L "$_active_backup" ] && [ ! -e "$VALISE_ACTIVE_LINK" ] && [ ! -L "$VALISE_ACTIVE_LINK" ]; then
      [ -n "$_mv_path" ] && "$_mv_path" "$_active_backup" "$VALISE_ACTIVE_LINK" 2>/dev/null || :
    else
      [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_active_backup" 2>/dev/null || :
    fi
    if [ -e "$_active_backup" ] || [ -L "$_active_backup" ]; then _cleanup_failed=1; fi
    _active_backup=""
  fi
  if [ -n "$_publish_tmp" ]; then
    remove_tree "$_publish_tmp" || _cleanup_failed=1
    _publish_tmp=""
  fi
  if [ -n "$_manifest_rows" ]; then
    [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_manifest_rows" 2>/dev/null || :
    if [ -e "$_manifest_rows" ] || [ -L "$_manifest_rows" ]; then _cleanup_failed=1; fi
    _manifest_rows=""
  fi
  if [ -n "$_manifest_parse" ]; then
    [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_manifest_parse" 2>/dev/null || :
    if [ -e "$_manifest_parse" ] || [ -L "$_manifest_parse" ]; then _cleanup_failed=1; fi
    _manifest_parse=""
  fi
  if [ -n "${_rg_tmp:-}" ]; then
    [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_rg_tmp" 2>/dev/null || :
    if [ -e "$_rg_tmp" ] || [ -L "$_rg_tmp" ]; then _cleanup_failed=1; fi
    _rg_tmp=""
  fi
  if [ -n "$_stage" ]; then
    remove_tree "$_stage" || _cleanup_failed=1
    _stage=""
  fi
  if [ -n "$_hook_tmp" ]; then
    [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_hook_tmp" 2>/dev/null || :
    if [ -e "$_hook_tmp" ] || [ -L "$_hook_tmp" ]; then _cleanup_failed=1; fi
    _hook_tmp=""
  fi
  if [ -n "$_mm_tmp" ]; then
    [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_mm_tmp" 2>/dev/null || :
    if [ -e "$_mm_tmp" ] || [ -L "$_mm_tmp" ]; then _cleanup_failed=1; fi
    _mm_tmp=""
  fi
  if [ -n "$_posix_tmp" ]; then
    [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$_posix_tmp" 2>/dev/null || :
    if [ -e "$_posix_tmp" ] || [ -L "$_posix_tmp" ]; then _cleanup_failed=1; fi
    _posix_tmp=""
  fi
  [ "$_lock_owned" -eq 1 ] || { [ "$_cleanup_failed" -eq 0 ]; return; }
  [ -n "$_release_rm_path" ] && "$_release_rm_path" -f "$VALISE_LOCK_DIR/pid" 2>/dev/null || :
  if [ -e "$VALISE_LOCK_DIR/pid" ] || [ -L "$VALISE_LOCK_DIR/pid" ]; then _cleanup_failed=1; fi
  [ -n "$_release_rmdir_path" ] && "$_release_rmdir_path" "$VALISE_LOCK_DIR" 2>/dev/null || :
  if [ -e "$VALISE_LOCK_DIR" ] || [ -L "$VALISE_LOCK_DIR" ]; then _cleanup_failed=1; fi
  _lock_owned=0
  [ "$_cleanup_failed" -eq 0 ]
}

_handle_int() {
  trap - INT
  release_lock
  exit 130
}

_handle_term() {
  trap - TERM
  release_lock
  exit 143
}

trap '_exit_status=$?; release_lock; if [ "$_exit_status" -eq 0 ] && [ "$_cleanup_failed" -ne 0 ]; then _exit_status=1; fi; exit "$_exit_status"' EXIT
trap '_handle_int' INT
trap '_handle_term' TERM

switch_active_link() {
  _ln_path=$(trusted_utility_path ln) || die "no trusted ln utility available"
  _readlink_path=$(trusted_utility_path readlink) || die "no trusted readlink utility available"
  if [ -e "$VALISE_ACTIVE_LINK" ] && [ ! -L "$VALISE_ACTIVE_LINK" ]; then
    die "active path exists and is not a symlink: $VALISE_ACTIVE_LINK"
  fi
  # ln -sfn replaces the destination symlink. On both BSD and GNU systems,
  # this executes unlink(2) followed by symlink(2), which is not atomic but
  # is the most portable approach available in pure POSIX sh (mv -h is
  # BSD-only, mv -T is GNU-only). The -n flag prevents following a
  # destination that is a symlink to a directory, making the swap act on
  # the symlink itself rather than descending into its target.
  "$_ln_path" -sfn "$1" "$VALISE_ACTIVE_LINK" || die "failed to update active symlink"
  [ -L "$VALISE_ACTIVE_LINK" ] || die "active symlink was not created"
  [ "$($_readlink_path "$VALISE_ACTIVE_LINK" 2>/dev/null)" = "$1" ] || die "active symlink target mismatch"
}

source_path_is_physical() {
  _source_root=$1
  _source_relative=$2
  _source_path=$_source_root
  _source_remaining=$_source_relative
  while [ -n "$_source_remaining" ]; do
    case "$_source_remaining" in
      */*)
        _source_component=${_source_remaining%%/*}
        _source_remaining=${_source_remaining#*/}
        ;;
      *)
        _source_component=$_source_remaining
        _source_remaining=
        ;;
    esac
    [ -n "$_source_component" ] || return 1
    _source_path=$_source_path/$_source_component
    [ ! -L "$_source_path" ] || return 1
  done
  return 0
}

validate_manifest() {
  _awk_path=$(trusted_utility_path awk) || return 1
  "$_awk_path" -F '\t' '
    NR == 1 { if ($0 != "shell-profile-release-manifest-v1") exit 10; next }
    NR == 2 { if ($1 != "destination" || $2 != "source" || $3 != "source_mode" || $4 != "install_mode" || $5 != "bytes" || $6 != "sha256" || NF != 6) exit 11; next }
    NF == 0 { next }
    NF != 6 || $1 == "" || $2 == "" || $1 !~ /^[A-Za-z0-9._\/-]+$/ || $2 !~ /^[A-Za-z0-9._\/-]+$/ || $1 ~ /^\// || $2 ~ /^\// || $1 ~ /\/$/ || $2 ~ /\/$/ || $1 ~ /^#/ || $1 == "destination" || $1 == "shell-profile-release-manifest-v1" || $3 !~ /^0(644|755)$/ || $4 != (($3 == "0644") ? "0444" : "0555") || $5 !~ /^[0-9]+$/ || length($6) != 64 || $6 !~ /^[0-9a-fA-F]+$/ || $1 ~ /(^|\/)\.($|\/)/ || index($1, "//") || $1 ~ /(^|\/)\.\.($|\/)/ || index($2, "//") || $2 ~ /(^|\/)\.($|\/)/ || $2 ~ /(^|\/)\.\.($|\/)/ || seen[$1]++ || seen_source[$2]++ { exit 12 }
    { data_rows = 1 }
    END { if (NR < 3 || data_rows != 1) exit 13 }
  ' "$1"
}

temp_path_is_safe() {
  _temp_candidate=$1
  _temp_kind=$2
  _temp_root=${3:-${TMPDIR:-/tmp}}
  case "$_temp_root" in /*) ;; *) return 1 ;; esac
  case "$_temp_candidate" in /*) ;; *) return 1 ;; esac
  [ -e "$_temp_candidate" ] || return 1
  [ ! -L "$_temp_candidate" ] || return 1
  case "$_temp_kind" in
    file) [ -f "$_temp_candidate" ] || return 1 ;;
    dir) [ -d "$_temp_candidate" ] || return 1 ;;
    *) return 1 ;;
  esac
  _temp_root_canonical=$(cd "$_temp_root" 2>/dev/null && pwd -P) || return 1
  _temp_parent=${_temp_candidate%/*}
  [ "$_temp_parent" != "$_temp_candidate" ] || _temp_parent=/
  _temp_parent_canonical=$(cd "$_temp_parent" 2>/dev/null && pwd -P) || return 1
  case "$_temp_parent_canonical/" in
    "$_temp_root_canonical/"*) ;;
    *) return 1 ;;
  esac
  return 0
}

trusted_mktemp_at() {
  _temp_root=$1
  _temp_kind=$2
  _temp_template=$3
  _mktemp_path=$(trusted_utility_path mktemp) || return 1
  case "$_temp_kind" in
    file) _temp_candidate=$("$_mktemp_path" "$_temp_template") || return 1 ;;
    dir) _temp_candidate=$("$_mktemp_path" -d "$_temp_template") || return 1 ;;
    *) return 1 ;;
  esac
  temp_path_is_safe "$_temp_candidate" "$_temp_kind" "$_temp_root" || return 1
  printf '%s\n' "$_temp_candidate"
}

trusted_mktemp() {
  trusted_mktemp_at "${TMPDIR:-/tmp}" "$@"
}

prepare_manifest_rows() {
  _cleanup_rm_path=$(trusted_utility_path rm) || return 1
  if [ -n "$_manifest_rows" ]; then
    "$_cleanup_rm_path" -f "$_manifest_rows" 2>/dev/null || :
    _manifest_rows=""
  fi
  if [ -n "$_manifest_parse" ]; then
    "$_cleanup_rm_path" -f "$_manifest_parse" 2>/dev/null || :
    _manifest_parse=""
  fi
  # _manifest_rows is the exact private snapshot used for identity and
  # publication. Parsing is performed from a second file that only adds a
  # final newline, so an unterminated source row is still consumed by POSIX
  # read without changing the bytes whose digest defines the release.
  _manifest_rows=$(trusted_mktemp file "${TMPDIR:-/tmp}/valise-manifest.XXXXXX") || return 1
  _cat_path=$(trusted_utility_path cat) || {
    "$_cleanup_rm_path" -f "$_manifest_rows" 2>/dev/null || :
    _manifest_rows=""
    return 1
  }
  "$_cat_path" "$1" >"$_manifest_rows" || {
    "$_cleanup_rm_path" -f "$_manifest_rows" 2>/dev/null || :
    _manifest_rows=""
    return 1
  }
  _manifest_parse=$(trusted_mktemp file "${TMPDIR:-/tmp}/valise-manifest-parse.XXXXXX") || {
    "$_cleanup_rm_path" -f "$_manifest_rows" 2>/dev/null || :
    _manifest_rows=""
    return 1
  }
  _awk_path=$(trusted_utility_path awk) || {
    "$_cleanup_rm_path" -f "$_manifest_rows" "$_manifest_parse" 2>/dev/null || :
    _manifest_rows=""
    _manifest_parse=""
    return 1
  }
  "$_awk_path" '{ print }' "$_manifest_rows" >"$_manifest_parse" || {
    "$_cleanup_rm_path" -f "$_manifest_rows" "$_manifest_parse" 2>/dev/null || :
    _manifest_rows=""
    _manifest_parse=""
    return 1
  }
}

locate_manifest() {
  _loc_script_dir=$(valise_script_dir) || return 1
  _loc_repo_root="$_loc_script_dir/.."
  for _loc_candidate in     "$_loc_repo_root/../shell/install/profile-release.manifest"     "$_loc_repo_root/shell/install/profile-release.manifest"     "./shell/install/profile-release.manifest"
  do
    if [ -f "$_loc_candidate" ]; then
      printf '%s\n' "$_loc_candidate"
      return 0
    fi
  done
  return 1
}

_manifest_has_file() {
  _awk_path=$(trusted_utility_path awk) || return 1
  "$_awk_path" -F '\t' -v destination="$2" '
    NR > 2 && NF && $1 == destination { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$1"
}

_manifest_has_descendant() {
  _awk_path=$(trusted_utility_path awk) || return 1
  "$_awk_path" -F '\t' -v prefix="$2/" '
    NR > 2 && NF && index($1, prefix) == 1 { found = 1 }
    END { exit found ? 0 : 1 }
  ' "$1"
}

verify_release_dir() {
  _verify_dir=$1
  _verify_manifest=$2
  _verify_canonical=$(cd "$_verify_dir" 2>/dev/null && pwd -P) || die "cannot resolve release root"
  [ "$(file_mode "$_verify_dir")" = "0555" ] || die "release root mode mismatch"
  _verify_snapshot="$_verify_dir/.valise-manifest"
  if [ -e "$_verify_snapshot" ] || [ -L "$_verify_snapshot" ]; then
    [ -f "$_verify_snapshot" ] || die "release manifest snapshot is not a regular file"
    [ ! -L "$_verify_snapshot" ] || die "release manifest snapshot must not be a symlink"
    [ "$(file_mode "$_verify_snapshot")" = "0444" ] || die "release manifest snapshot mode mismatch"
    [ "$(file_bytes "$_verify_snapshot")" = "$(file_bytes "$_verify_manifest")" ] || die "release manifest snapshot byte count mismatch"
    _verify_snapshot_digest=$(file_sha256 "$_verify_snapshot") || die "no SHA-256 utility available"
    _verify_manifest_digest=$(file_sha256 "$_verify_manifest") || die "no SHA-256 utility available"
    [ "$_verify_snapshot_digest" = "$_verify_manifest_digest" ] || die "release manifest snapshot digest mismatch"
    _verify_expected_id="${3:-}"
    if [ -z "$_verify_expected_id" ]; then
      _verify_expected_id=$(basename "$_verify_dir")
    fi
    [ "$_verify_snapshot_digest" = "$_verify_expected_id" ] || die "release manifest snapshot identity mismatch"
  fi
  while IFS="$(printf '\t')" read -r _dest _src _mode _imode _size _sha; do
    [ -n "$_dest" ] || continue
    case "$_dest" in shell-profile-release-manifest-v1|destination) continue ;; esac
    _verify_file="$_verify_dir/$_dest"
    [ -f "$_verify_file" ] || die "release file missing: $_dest"
    [ ! -L "$_verify_file" ] || die "release file must not be a symlink: $_dest"
    _verify_parent=$(cd "$(path_parent "$_verify_file")" 2>/dev/null && pwd -P) || die "release parent missing: $_dest"
    case "$_verify_parent/" in "$_verify_canonical/"*) : ;; *) die "release path escapes target: $_dest" ;; esac
    [ "$(file_mode "$_verify_file")" = "$_imode" ] || die "release mode mismatch for $_dest"
    [ "$(file_bytes "$_verify_file")" = "$_size" ] || die "release byte count mismatch for $_dest"
    case "$_sha" in *[!0123456789abcdefABCDEF]*) die "invalid release digest for $_dest" ;; esac
    [ "${#_sha}" -eq 64 ] || die "invalid release digest for $_dest"
    _verify_actual=$(file_sha256 "$_verify_file") || die "no trusted SHA-256 utility available"
    _verify_expected=$(printf '%s' "$_sha" | lower_hex) || die "no trusted tr utility available"
    [ "$_verify_actual" = "$_verify_expected" ] || die "release digest mismatch for $_dest"
  done < "${_manifest_parse:-$_manifest_rows}"
  _find_path=$(trusted_utility_path find) || die "no trusted find utility available"
  _verify_bad=$("$_find_path" "$_verify_dir" -print | while IFS= read -r _verify_path; do
    [ "$_verify_path" = "$_verify_dir" ] && continue
    if [ -L "$_verify_path" ]; then
      printf '%s\n' "$_verify_path"
      break
    fi
    _verify_relative=${_verify_path#"$_verify_dir"/}
    [ "$_verify_relative" = ".valise-manifest" ] && continue
    if [ -f "$_verify_path" ]; then
      _manifest_has_file "$_verify_manifest" "$_verify_relative" || { printf '%s\n' "$_verify_path"; break; }
    elif [ -d "$_verify_path" ]; then
      if [ "$(file_mode "$_verify_path")" != "0555" ] || ! _manifest_has_descendant "$_verify_manifest" "$_verify_relative"; then
        printf '%s\n' "$_verify_path"
        break
      fi
    else
      printf '%s\n' "$_verify_path"
      break
    fi
  done)
  [ -z "$_verify_bad" ] || die "release contains unmanifested or mutable path: $_verify_bad"
}

# --- Subcommands ---

cmd_version() {
  printf '%s\n' "$VALISE_VERSION"
}

print_fish_integration() {
  _fish_active_literal=$(fish_quote "$VALISE_ACTIVE_LINK") || return 1
  _fish_cli_dir=$(cd "$(path_parent "$0")" 2>/dev/null && pwd -P) || return 1
  _fish_cli_path="$_fish_cli_dir/${0##*/}"
  _fish_cli_literal=$(fish_quote "$_fish_cli_path") || return 1
  _fish_source_tree_mode=${_fish_source_tree_mode:-0}
  printf '%s\n' \
    "# valise shell integration" \
    "begin" \
    "set -l _valise_fish_source_tree_mode $_fish_source_tree_mode" \
    "set -l _valise_fish_previous_root ''" \
    "if builtin set -q SHELL_PROJECT_ROOT; and builtin test (builtin count \$SHELL_PROJECT_ROOT) -eq 1" \
    "  set _valise_fish_previous_root (builtin path resolve -- \"\$SHELL_PROJECT_ROOT\" 2>/dev/null)" \
    "end" \
    "# Authenticate the universal-variable store before any untrusted release source runs." \
    "set -l _valise_fish_persistence_config_home ''" \
    "if builtin set -q XDG_CONFIG_HOME; and test -n \"\$XDG_CONFIG_HOME\"" \
    "  set _valise_fish_persistence_config_home \"\$XDG_CONFIG_HOME\"" \
    "else if builtin set -q HOME; and test -n \"\$HOME\"" \
    "  set _valise_fish_persistence_config_home \"\$HOME/.config\"" \
    "else" \
    "  builtin exit 125" \
    "end" \
    "set -l _valise_fish_persistence_durable_file \"\$_valise_fish_persistence_config_home/fish/fish_variables\"" \
    "set -g _valise_fish_persistence_path_physical_helper __valise_fish_path_(builtin random)" \
    "function \$_valise_fish_persistence_path_physical_helper --no-scope-shadowing" \
    "  set -l _persistence_path \$argv[1]" \
    "  if test -x /usr/bin/uname; and test (/usr/bin/uname -s 2>/dev/null) = Darwin" \
    "    if builtin test -L /var; and test (builtin path resolve -- /var 2>/dev/null) = /private/var" \
    "      switch \"\$_persistence_path\"" \
    "        case /var" \
    "          set _persistence_path /private/var" \
    "        case '/var/*'" \
    "          set _persistence_path (builtin string replace -r '^/var' /private/var -- \"\$_persistence_path\")" \
    "      end" \
    "    end" \
    "    if builtin test -L /tmp; and test (builtin path resolve -- /tmp 2>/dev/null) = /private/tmp" \
    "      switch \"\$_persistence_path\"" \
    "        case /tmp" \
    "          set _persistence_path /private/tmp" \
    "        case '/tmp/*'" \
    "          set _persistence_path (builtin string replace -r '^/tmp' /private/tmp -- \"\$_persistence_path\")" \
    "      end" \
    "    end" \
    "  end" \
    "  if not builtin string match -q '/*' -- \"\$_persistence_path\"; or builtin string match -q '*//*' -- \"\$_persistence_path\"" \
    "    return 1" \
    "  end" \
    "  set _persistence_prefix /" \
    "  for _persistence_component in (builtin string split '/' -- \"\$_persistence_path\")" \
    "    if test -z \"\$_persistence_component\"" \
    "      continue" \
    "    end" \
    "    switch \"\$_persistence_component\"" \
    "      case . .." \
    "        return 1" \
    "    end" \
    "    if test \"\$_persistence_prefix\" = /" \
    "      set _persistence_prefix /\$_persistence_component" \
    "    else" \
    "      set _persistence_prefix \"\$_persistence_prefix/\$_persistence_component\"" \
    "    end" \
    "    if builtin test -L \"\$_persistence_prefix\"" \
    "      return 1" \
    "    end" \
    "  end" \
    "  return 0" \
    "end" \
    "if not \$_valise_fish_persistence_path_physical_helper \"\$_valise_fish_persistence_durable_file\"" \
    "  builtin exit 125" \
    "end" \
    "# Capture an absolute, writable, searchable temp parent before untrusted source." \
    "set -l _valise_fish_persistence_tmp_parent /tmp" \
    "if builtin set -q TMPDIR; and test -n \"\$TMPDIR\"" \
    "  set _valise_fish_persistence_tmp_parent \"\$TMPDIR\"" \
    "end" \
    "set _valise_fish_persistence_tmp_parent (builtin path resolve -- \"\$_valise_fish_persistence_tmp_parent\" 2>/dev/null)" \
    "if test (builtin count \$_valise_fish_persistence_tmp_parent) -ne 1; or not test -d \"\$_valise_fish_persistence_tmp_parent\"; or not test -w \"\$_valise_fish_persistence_tmp_parent\"; or not test -x \"\$_valise_fish_persistence_tmp_parent\"" \
    "  builtin exit 125" \
    "end" \
    "# Capture persistent SHELL_PROJECT_ROOT scopes before clearing activation state." \
    "set -l _valise_fish_scratch_names _valise_fish_root_global_set _valise_fish_root_global_exported _valise_fish_root_global_values _valise_fish_root_universal_set _valise_fish_root_universal_exported _valise_fish_root_universal_values VALISE_MODULE_ROOT XDG_CONFIG_HOME TMPDIR HOME" \
    "set -l _valise_fish_scratch_prefix __valise_fish_scratch_state_(builtin random)" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_set_global_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_set_global_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_set_global_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_set_universal_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_set_universal_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_set_universal_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_exported_global_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_exported_global_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_exported_global_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_exported_universal_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_exported_universal_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_exported_universal_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_values_global_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_values_global_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_values_global_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_values_universal_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_values_universal_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_global_values_universal_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_set_global_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_set_global_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_set_global_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_set_universal_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_set_universal_exported" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_set_universal_values" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_exported_global_present" \
    "set -l \"\$_valise_fish_scratch_prefix\"__valise_fish_root_universal_exported_global_exported" \
