{
  "name": "valise-sh",
  "version": "0.3.0",
  "description": "Pure POSIX shell profile engine and CLI",
  "bin": {
    "valise": "./bin/valise"
  },
  "files": [
    "bin/valise",
    "lib/*.sh",
    "lib/*.awk",
    "lib/cli/*.sh",
    "lib/fish/*.fish",
    "modules/**/*.sh",
    "module.d/*.meta",
    "entrypoints/*.sh",
    "manifests/*.tsv",
    "docs/*.md",
    "examples/**/*.md",
    "examples/**/*.meta",
    "examples/**/*.sh",
    "examples/**/*.fish",
    "examples/**/*.tsv",
    "examples/**/valise.conf",
    "!examples/**/build/",
    "!examples/**/node_modules/",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "shell",
    "profile",
    "posix",
    "bash",
    "zsh",
    "ksh",
    "fish",
    "dotfiles"
  ],
  "author": "joeycumines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joeycumines/valise-sh.git"
  },
  "dependencies": {},
  "engines": {
    "node": ">=14.0.0"
  }
}
